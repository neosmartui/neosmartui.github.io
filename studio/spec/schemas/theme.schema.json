{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neosmartui.com/schemas/theme@1.json",
  "title": "NeoSmartUI Theme Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "family", "category", "color", "typography", "geometry", "border", "shadow", "spacing", "density", "motion", "interaction", "icons"],
  "properties": {
    "$schema": {"type": "string"},
    "schema": {"const": "neosmartui/theme@1"},
    "name": {"type": "string", "minLength": 1},
    "family": {"const": "neosmartui"},
    "category": {"type": "string", "minLength": 1},
    "color": {"type": "object"},
    "typography": {"type": "object"},
    "geometry": {"type": "object"},
    "border": {"type": "object"},
    "shadow": {"type": "object"},
    "spacing": {"type": "object"},
    "density": {"type": "object"},
    "motion": {"type": "object"},
    "interaction": {"type": "object"},
    "icons": {"type": "object"}
  }
}
