{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neosmartui.com/schemas/theme-resolution@1.json",
  "title": "NeoSmartUI Theme Resolution v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "flavor", "theme", "bundle", "scope"],
  "properties": {
    "$schema": {"type":"string"},
    "schema": {"const":"neosmartui/theme-resolution@1"},
    "flavor": {"type":"string","pattern":"^flavor\\.[a-z][a-z0-9-]*$"},
    "theme": {"type":"string","minLength":1},
    "bundle": {"type":"string","minLength":1},
    "scope": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}}
  }
}
