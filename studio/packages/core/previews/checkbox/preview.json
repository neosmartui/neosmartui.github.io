{
  "$schema": "../../../../spec/schemas/component-preview.schema.json",
  "schema": "neosmartui/component-preview@1",
  "component": "core.checkbox",
  "fixture": "fixture.html",
  "controller": "controller.mjs",
  "fixtureComponents": [],
  "defaultState": "rest",
  "resetStrategy": "remount",
  "stateRealization": {
    "rest": {
      "mode": "fixture",
      "target": "#checkbox-demo"
    },
    "hover": {
      "mode": "native-pointer",
      "target": "#checkbox-demo"
    },
    "focus-visible": {
      "mode": "native-keyboard",
      "target": "#checkbox-demo"
    },
    "pressed": {
      "mode": "native-pointer",
      "target": "#checkbox-demo"
    },
    "unchecked": {
      "mode": "fixture",
      "target": "#checkbox-demo"
    },
    "checked": {
      "mode": "controller",
      "target": "#checkbox-demo"
    },
    "indeterminate": {
      "mode": "fixture",
      "target": "#checkbox-mixed"
    },
    "invalid": {
      "mode": "controller",
      "target": "#checkbox-demo"
    },
    "disabled": {
      "mode": "controller",
      "target": "#checkbox-demo"
    }
  },
  "renderers": {
    "web": {
      "styles": [
        "packages/adapters/web/components/checkbox.css"
      ],
      "bindings": [
        {
          "module": "packages/adapters/web/components/checkbox.mjs",
          "export": "bindCheckbox",
          "selector": "#checkbox-demo"
        },
        {
          "module": "packages/adapters/web/components/checkbox.mjs",
          "export": "bindCheckbox",
          "selector": "#checkbox-mixed",
          "options": {
            "indeterminate": true
          }
        }
      ]
    }
  }
}
