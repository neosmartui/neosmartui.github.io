{
  "$schema": "../../../spec/schemas/component.schema.json",
  "schema": "neosmartui/component@1",
  "id": "core.breadcrumb",
  "layer": "component",
  "domain": "core",
  "intent": "Expose the current location as an ordered hierarchical navigation path with real ancestor links, a non-interactive current page, and presentation-only separators.",
  "states": ["rest", "current"],
  "dependencies": [
    "color.content.primary",
    "color.content.secondary",
    "color.focus.ring",
    "space.navigation.gap",
    "focus.ring.width",
    "focus.ring.offset",
    "font.family.body",
    "font.size.navigation",
    "font.weight.regular",
    "font.weight.emphasis"
  ],
  "supports": {
    "keyboard": true,
    "touch": true,
    "rtl": true,
    "reducedMotion": true,
    "forcedColors": true
  }
}
