{
  "$schema": "../../../spec/schemas/component.schema.json",
  "schema": "neosmartui/component@1",
  "id": "core.radio",
  "layer": "component",
  "domain": "core",
  "intent": "Select one option within a mutually exclusive choice set while preserving native radio-group semantics.",
  "states": [
    "rest",
    "hover",
    "focus-visible",
    "pressed",
    "unchecked",
    "checked",
    "invalid",
    "disabled"
  ],
  "dependencies": [
    "color.surface.interactive",
    "color.content.primary",
    "color.border.default",
    "color.border.strong",
    "color.action.primary.surface",
    "color.action.primary.content",
    "color.state.error",
    "border.control.width",
    "radius.control",
    "size.control.minimum",
    "depth.rest.x",
    "depth.rest.y",
    "depth.hover.x",
    "depth.hover.y",
    "depth.active.x",
    "depth.active.y",
    "press.hover.x",
    "press.hover.y",
    "press.active.x",
    "press.active.y",
    "motion.press.duration",
    "motion.press.easing",
    "motion.release.duration",
    "motion.release.easing",
    "color.focus.ring",
    "focus.ring.width",
    "focus.ring.offset",
    "opacity.disabled"
  ],
  "supports": {
    "keyboard": true,
    "touch": true,
    "rtl": true,
    "reducedMotion": true,
    "forcedColors": true
  }
}
