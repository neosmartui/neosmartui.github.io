{
  "$schema": "../../../spec/schemas/component.schema.json",
  "schema": "neosmartui/component@1",
  "id": "core.switch",
  "layer": "component",
  "domain": "core",
  "intent": "Toggle a single binary setting between off and on with immediate state feedback.",
  "states": ["rest", "hover", "focus-visible", "pressed", "off", "on", "invalid", "disabled"],
  "dependencies": [
    "color.surface.interactive",
    "color.action.primary.surface",
    "color.action.primary.content",
    "color.border.strong",
    "color.state.error",
    "border.control.width",
    "radius.control",
    "size.control.minimum",
    "depth.rest.x",
    "depth.rest.y",
    "depth.hover.x",
    "depth.hover.y",
    "depth.active.x",
    "depth.active.y",
    "press.hover.x",
    "press.hover.y",
    "press.active.x",
    "press.active.y",
    "motion.press.duration",
    "motion.press.easing",
    "motion.release.duration",
    "motion.release.easing",
    "motion.standard.duration",
    "motion.standard.easing",
    "color.focus.ring",
    "focus.ring.width",
    "focus.ring.offset",
    "opacity.disabled"
  ],
  "supports": {
    "keyboard": true,
    "touch": true,
    "rtl": true,
    "reducedMotion": true,
    "forcedColors": true
  }
}
