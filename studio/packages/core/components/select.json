{
  "$schema": "../../../spec/schemas/component.schema.json",
  "schema": "neosmartui/component@1",
  "id": "core.select",
  "layer": "component",
  "domain": "core",
  "intent": "Choose one value from a finite option set through a native single-select control.",
  "states": ["rest", "hover", "focus-visible", "pressed", "selected", "invalid", "disabled"],
  "dependencies": [
    "color.surface.interactive",
    "color.content.primary",
    "color.content.secondary",
    "color.border.default",
    "color.border.strong",
    "color.state.error",
    "border.control.width",
    "radius.control",
    "space.control.inline",
    "space.control.block",
    "size.control.minimum",
    "depth.rest.x",
    "depth.rest.y",
    "depth.hover.x",
    "depth.hover.y",
    "depth.active.x",
    "depth.active.y",
    "press.hover.x",
    "press.hover.y",
    "press.active.x",
    "press.active.y",
    "motion.press.duration",
    "motion.press.easing",
    "motion.release.duration",
    "motion.release.easing",
    "color.focus.ring",
    "focus.ring.width",
    "focus.ring.offset",
    "opacity.disabled",
    "font.family.body",
    "font.size.body",
    "font.weight.regular"
  ],
  "supports": {
    "keyboard": true,
    "touch": true,
    "rtl": true,
    "reducedMotion": true,
    "forcedColors": true
  }
}
