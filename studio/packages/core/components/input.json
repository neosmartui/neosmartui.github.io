{
  "$schema": "../../../spec/schemas/component.schema.json",
  "schema": "neosmartui/component@1",
  "id": "core.input",
  "layer": "component",
  "domain": "core",
  "intent": "Accept a single-line user-entered textual value through a native text-like input control.",
  "states": ["rest", "hover", "focus-visible", "empty", "filled", "invalid", "read-only", "disabled"],
  "dependencies": [
    "color.surface.interactive",
    "color.content.primary",
    "color.content.secondary",
    "color.border.default",
    "color.border.strong",
    "color.state.error",
    "border.control.width",
    "radius.control",
    "space.control.inline",
    "space.control.block",
    "size.control.minimum",
    "color.focus.ring",
    "focus.ring.width",
    "focus.ring.offset",
    "opacity.disabled",
    "font.family.body",
    "font.size.body",
    "font.weight.regular",
    "motion.standard.duration",
    "motion.standard.easing"
  ],
  "supports": {
    "keyboard": true,
    "touch": true,
    "rtl": true,
    "reducedMotion": true,
    "forcedColors": true
  }
}
