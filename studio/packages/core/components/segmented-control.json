{
  "$schema": "../../../spec/schemas/component.schema.json",
  "schema": "neosmartui/component@1",
  "id": "core.segmented-control",
  "layer": "component",
  "domain": "core",
  "intent": "Choose exactly one active mode or view from a small set of peer button actions while preserving persistent selected state, native button activation, and a clear boundary from form-value radio groups and tab-panel composites.",
  "states": ["rest", "hover", "focus-visible", "pressed", "selected", "disabled"],
  "dependencies": [
    "color.surface.panel",
    "color.surface.interactive",
    "color.content.primary",
    "color.content.secondary",
    "color.border.strong",
    "color.action.primary.surface",
    "color.action.primary.content",
    "color.focus.ring",
    "space.navigation.gap",
    "space.control.inline",
    "space.control.block",
    "border.control.width",
    "radius.control",
    "size.control.minimum",
    "depth.rest.x",
    "depth.rest.y",
    "depth.hover.x",
    "depth.hover.y",
    "depth.active.x",
    "depth.active.y",
    "press.hover.x",
    "press.hover.y",
    "press.active.x",
    "press.active.y",
    "motion.press.duration",
    "motion.release.duration",
    "focus.ring.width",
    "focus.ring.offset",
    "opacity.disabled",
    "font.family.body",
    "font.size.label",
    "font.weight.emphasis"
  ],
  "supports": {
    "keyboard": true,
    "touch": true,
    "rtl": true,
    "reducedMotion": true,
    "forcedColors": true
  }
}
