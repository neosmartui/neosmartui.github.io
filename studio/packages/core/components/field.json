{
  "$schema": "../../../spec/schemas/component.schema.json",
  "schema": "neosmartui/component@1",
  "id": "core.field",
  "layer": "component",
  "domain": "core",
  "intent": "Associate one primary form control with its visible label, description/help, requirement context, and validation message without replacing the control's native semantics.",
  "states": ["rest", "invalid", "disabled"],
  "dependencies": [
    "color.content.primary",
    "color.content.secondary",
    "color.state.error",
    "space.field.gap",
    "font.family.body",
    "font.size.body",
    "font.size.label",
    "font.weight.regular",
    "font.weight.emphasis"
  ],
  "supports": {
    "keyboard": true,
    "touch": true,
    "rtl": true,
    "reducedMotion": true,
    "forcedColors": true
  }
}
