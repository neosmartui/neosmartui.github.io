{
  "$schema": "../../../spec/schemas/component.schema.json",
  "schema": "neosmartui/component@1",
  "id": "core.combobox",
  "layer": "component",
  "domain": "core",
  "intent": "Edit a text query while navigating and committing one value from a related suggestion list without importing business-domain filtering semantics.",
  "states": ["rest", "hover", "focus-visible", "pressed", "closed", "open", "query-empty", "query-filled", "highlighted", "selected", "invalid", "disabled"],
  "dependencies": [
    "color.surface.interactive",
    "color.surface.panel",
    "color.content.primary",
    "color.content.secondary",
    "color.border.default",
    "color.border.strong",
    "color.action.primary.surface",
    "color.action.primary.content",
    "color.state.error",
    "color.focus.ring",
    "space.control.inline",
    "space.control.block",
    "space.surface.inline",
    "space.surface.block",
    "border.control.width",
    "border.surface.width",
    "radius.control",
    "radius.surface",
    "size.control.minimum",
    "depth.rest.x",
    "depth.rest.y",
    "depth.hover.x",
    "depth.hover.y",
    "depth.active.x",
    "depth.active.y",
    "press.hover.x",
    "press.hover.y",
    "press.active.x",
    "press.active.y",
    "motion.press.duration",
    "motion.press.easing",
    "motion.release.duration",
    "motion.release.easing",
    "motion.standard.duration",
    "motion.standard.easing",
    "focus.ring.width",
    "focus.ring.offset",
    "opacity.disabled",
    "font.family.body",
    "font.size.body",
    "font.weight.regular",
    "font.weight.emphasis"
  ],
  "supports": {
    "keyboard": true,
    "touch": true,
    "rtl": true,
    "reducedMotion": true,
    "forcedColors": true
  }
}
